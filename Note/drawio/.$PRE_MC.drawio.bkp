        <mxCell id="V7t6YtebRoBzCXfYw2tL-2" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="-970" y="-1160" width="520" height="234" as="geometry" />
        </mxCell>
        <mxCell id="qGTWO_OlCe-dsGvAULmi-58" value="设计方案1：是用bitmap对比SRAM中每一行；&lt;br&gt;&lt;br&gt;&lt;div&gt;优点：时序会好一些，少了bitmap转index的逻辑；&lt;br&gt;缺点：面积会更大，是用更多的与非门对比SRAM；&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="1" vertex="1">
          <mxGeometry x="100" y="-968" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="qGTWO_OlCe-dsGvAULmi-177" value="设计方案2：是用bitmap转换为index索引SRAM；&lt;br&gt;&lt;br&gt;&lt;div&gt;优点：面积更小，直接选取SRAM中信息；&lt;br&gt;缺点：时序更差了，中间添加了bitmap转index的组合逻辑；&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=11;fontColor=default;labelBackgroundColor=default;" parent="1" vertex="1">
