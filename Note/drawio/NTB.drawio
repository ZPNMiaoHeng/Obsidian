        <mxCell id="TY9dxGnuIg9n5i_ZsLF7-1" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font&gt;注意⚠️&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;1、NT组播这里的表内容为协议中能力寄存器，通过host下发config报文进行配置，config报文携带1DW的数据，一次只能配置32bit；&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font&gt;2、&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;NTB NT组播不修改ECRC，放在后级slice、mc_overlay判断；&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;（1）组播的MC overlay只有在出口才知道要不要重新寄存器ECRC；&lt;/font&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;（2）存在组播在MC_overlay中不修改地址的场景，此时不需要重新计算ECRC。&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="730" x="-2320" y="240" as="geometry" />
        </mxCell>
